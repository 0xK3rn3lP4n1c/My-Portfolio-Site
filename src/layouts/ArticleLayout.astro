---
import BaseLayout from './BaseLayout.astro';
interface Props {
  title: string;
  description: string;
  date: Date;
  tags?: string[];
}
const { title, description, date, tags = [] } = Astro.props;
---
<BaseLayout title={`${title} — Ömer Kaan Coşkun`} description={description}>
  <article class="container prose article">
    <header class="head">
      <time class="mono" datetime={date.toISOString()}>
        {date.toLocaleDateString('tr-TR', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
      <h1>{title}</h1>
      <div class="tags">{tags.map((t) => <span class="tag">{t}</span>)}</div>
    </header>
    <div class="body">
      <slot />
    </div>
  </article>
  <div class="container after">
    <slot name="after" />
  </div>
</BaseLayout>

<style>
  .article { padding-block: var(--space-l); }
  .head { margin-bottom: var(--space-l); }
  .head time { color: var(--cyan-dim); font-size: var(--step--1); }
  .head h1 { margin-top: var(--space-xs); }
  .body :global(h2) { margin-top: var(--space-l); }
  .body :global(pre) {
    background: var(--bg-elev); border: 1px solid var(--border);
    border-radius: var(--radius-s); padding: var(--space-s); overflow-x: auto;
  }
  .body :global(code) { font-family: var(--font-mono); }
  .body :global(a) { text-decoration: underline; }
  .after { padding-bottom: var(--space-l); }
</style>
