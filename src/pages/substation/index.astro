---
// Hidden OT lab — the "capture-the-process" HMI. Unlinked, noindex, excluded from the
// sitemap (see astro.config sitemap filter). Reached only via the /backup breadcrumb trail.
// Deliberately self-contained (no site Nav/Footer) so it reads as a real operator panel.
// All logic is client-side make-believe: no network, no secrets. See substationEngine.ts.
const title = 'EAST 110 kV — Operator HMI';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Ubuntu+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="hmi">
      <header class="topbar">
        <div class="brand">
          <span class="dot" aria-hidden="true"></span>
          EAST 110&nbsp;kV SUBSTATION · OPERATOR HMI
        </div>
        <div class="link">
          <span id="clock" class="clock mono">--:--:--</span>
          <span class="sep">·</span>
          RTU 192.168.95.10 · IEC-104 · <span id="rtu-state" class="online">ONLINE</span>
          <span class="sep">·</span>
          <a href="/" title="leave panel">⌂</a>
        </div>
      </header>

      <main class="grid">
        <!-- ── Single-line diagram ─────────────────────────────── -->
        <section class="panel diagram" aria-label="Substation single-line diagram">
          <h2 class="panel-h">SINGLE-LINE · EAST 110&nbsp;kV</h2>
          <svg viewBox="0 0 360 470" role="img" aria-label="Single-line diagram of the substation">
            <!-- grid infeed -->
            <text x="180" y="16" class="lbl mid">GRID INFEED · 110 kV</text>
            <circle cx="180" cy="32" r="8" fill="none" stroke="#e0a63a" stroke-width="2" />
            <path d="M176 32 l8 0 M180 28 l0 8" stroke="#e0a63a" stroke-width="1.5" />
            <line id="c-grid" x1="180" y1="40" x2="180" y2="74" stroke="#e0a63a" stroke-width="3" />

            <!-- CB-01 line breaker -->
            <rect id="cb01-box" x="171" y="82" width="18" height="18" fill="#e0483a" stroke="#e0483a" stroke-width="2" />
            <text x="200" y="90" class="lbl">CB-01 · 110 kV Line</text>
            <text id="cb01-state" x="200" y="102" class="state">CLOSED</text>
            <line id="c-a" x1="180" y1="100" x2="180" y2="150" stroke="#e0a63a" stroke-width="3" />

            <!-- protection relay -->
            <rect x="252" y="112" width="98" height="40" rx="3" fill="#0e1a24" stroke="#26384a" />
            <text x="262" y="127" class="lbl sm">PROT-1 (PTRC)</text>
            <circle id="prot-led" cx="264" cy="140" r="5" fill="#39d353" />
            <text id="prot-text" x="276" y="144" class="state sm">HEALTHY</text>
            <path d="M252 132 L200 108" stroke="#26384a" stroke-width="1" stroke-dasharray="3 3" />

            <!-- busbar -->
            <line id="bus" x1="70" y1="160" x2="300" y2="160" stroke="#e0a63a" stroke-width="5" />
            <text x="70" y="152" class="lbl">110 kV BUS</text>
            <text id="bus-volt" x="300" y="152" class="state end">110.0 kV</text>

            <!-- feeder A -->
            <line id="c-fa-top" x1="120" y1="160" x2="120" y2="212" stroke="#e0a63a" stroke-width="3" />
            <rect id="cb02-box" x="111" y="212" width="18" height="18" fill="#e0483a" stroke="#e0483a" stroke-width="2" />
            <text x="8" y="224" class="lbl">CB-02</text>
            <text id="cb02-state" x="8" y="235" class="state sm">CLOSED</text>
            <line id="c-fa-bot" x1="120" y1="230" x2="120" y2="300" stroke="#e0a63a" stroke-width="3" />
            <path d="M104 300 h32 l-16 -14 z" fill="none" stroke="#7f93a8" stroke-width="1.5" />
            <text x="120" y="330" class="lbl mid">FEEDER A · TOWN</text>
            <text x="120" y="342" class="lbl mid sm">34 MW</text>

            <!-- feeder B -->
            <line id="c-fb-top" x1="250" y1="160" x2="250" y2="212" stroke="#e0a63a" stroke-width="3" />
            <rect id="cb03-box" x="241" y="212" width="18" height="18" fill="#e0483a" stroke="#e0483a" stroke-width="2" />
            <text x="270" y="224" class="lbl">CB-03</text>
            <text id="cb03-state" x="270" y="235" class="state sm">CLOSED</text>
            <line id="c-fb-bot" x1="250" y1="230" x2="250" y2="300" stroke="#e0a63a" stroke-width="3" />
            <rect x="238" y="300" width="24" height="18" fill="none" stroke="#7f93a8" stroke-width="1.5" />
            <text x="250" y="336" class="lbl mid">FEEDER B · IND.</text>
            <text x="250" y="348" class="lbl mid sm">21 MW</text>

            <!-- legend -->
            <rect x="8" y="440" width="10" height="10" fill="#e0483a" />
            <text x="24" y="449" class="lbl sm">closed / live</text>
            <rect x="120" y="440" width="10" height="10" fill="none" stroke="#39d353" stroke-width="2" />
            <text x="136" y="449" class="lbl sm">open / dead</text>
          </svg>

          <div class="alarms" aria-live="polite">
            <div class="alarms-h">EVENT / ALARM LOG</div>
            <ul id="alarm-list"><li class="quiet">— no active alarms —</li></ul>
          </div>
        </section>

        <!-- ── Engineering console ─────────────────────────────── -->
        <section class="panel console">
          <h2 class="panel-h">ENGINEERING CONSOLE</h2>
          <div id="out" class="out mono" aria-live="polite" tabindex="0"></div>
          <form id="cmdform" class="prompt" autocomplete="off">
            <label for="cmd" class="ps1 mono" aria-label="command">iec&gt;</label>
            <input id="cmd" class="mono" type="text" spellcheck="false" autocapitalize="off"
                   autocorrect="off" aria-label="console command" autofocus />
          </form>
        </section>
      </main>
    </div>

    <!-- win overlay -->
    <div id="win" class="win" hidden>
      <div class="win-card" role="dialog" aria-modal="true" aria-labelledby="win-title" tabindex="-1">
        <div class="win-h" id="win-title">▚ SUBSTATION BLACKOUT ▚</div>
        <p class="win-sub">Total busbar de-energisation. Town and industrial feeders dark.</p>
        <div class="flag mono" id="flagbox"></div>
        <p class="win-note">
          You just re-played the <strong>2016 Industroyer / CrashOverride</strong> sequence:
          map the field with IEC&nbsp;60870-5-104, silence the protection relay over IEC&nbsp;61850 MMS,
          then trip the line breaker. A year earlier, <strong>BlackEnergy</strong> reached the same
          result by hijacking the operators' own HMI.
        </p>
        <div class="win-actions">
          <button id="copyflag" class="btn" type="button">Copy flag</button>
          <a class="btn primary" href="/substation/debrief">Read the full debrief →</a>
          <button id="closewin" class="btn ghost" type="button">Back to panel</button>
        </div>
      </div>
    </div>

    <script>
      import { createSubstation, type Line } from '../../components/lab/substationEngine';

      const sub = createSubstation();
      const out = document.getElementById('out') as HTMLDivElement;
      const form = document.getElementById('cmdform') as HTMLFormElement;
      const cmd = document.getElementById('cmd') as HTMLInputElement;
      const win = document.getElementById('win') as HTMLDivElement;

      const LIVE = '#e0a63a';
      const DEAD = '#37485c';
      const CLOSED = '#e0483a';
      const OPEN = '#39d353';

      const history: string[] = [];
      let hIdx = 0;

      function print(kind: string, text: string) {
        const div = document.createElement('div');
        div.className = 'ln ' + kind;
        div.textContent = text;
        out.appendChild(div);
        out.scrollTop = out.scrollHeight;
      }

      function boot() {
        print('info', 'East 110 kV Substation — Operator HMI  (engineering session)');
        print('info', "RTU reachable. This is a restricted panel. Type 'help' for commands.");
      }

      function setAttr(id: string, attr: string, val: string) {
        const el = document.getElementById(id);
        if (el) el.setAttribute(attr, val);
      }
      function setText(id: string, val: string) {
        const el = document.getElementById(id);
        if (el) el.textContent = val;
      }

      function syncDiagram() {
        const s = sub.getState();
        const cb01 = s.breakers.CB01.closed;
        const cb02 = s.breakers.CB02.closed;
        const cb03 = s.breakers.CB03.closed;
        const busLive = s.busEnergized;

        const paintBreaker = (box: string, st: string, closed: boolean) => {
          setAttr(box, 'fill', closed ? CLOSED : 'none');
          setAttr(box, 'stroke', closed ? CLOSED : OPEN);
          setText(st, closed ? 'CLOSED' : 'OPEN');
          const el = document.getElementById(st);
          if (el) el.setAttribute('fill', closed ? CLOSED : OPEN);
        };
        paintBreaker('cb01-box', 'cb01-state', cb01);
        paintBreaker('cb02-box', 'cb02-state', cb02);
        paintBreaker('cb03-box', 'cb03-state', cb03);

        setAttr('c-a', 'stroke', cb01 ? LIVE : DEAD);
        setAttr('bus', 'stroke', busLive ? LIVE : DEAD);
        setAttr('c-fa-top', 'stroke', busLive ? LIVE : DEAD);
        setAttr('c-fb-top', 'stroke', busLive ? LIVE : DEAD);
        setAttr('c-fa-bot', 'stroke', busLive && cb02 ? LIVE : DEAD);
        setAttr('c-fb-bot', 'stroke', busLive && cb03 ? LIVE : DEAD);

        setText('bus-volt', s.busVoltage.toFixed(1) + ' kV');
        const bv = document.getElementById('bus-volt');
        if (bv) bv.setAttribute('fill', busLive ? LIVE : '#e0483a');

        setAttr('prot-led', 'fill', s.protectionEnabled ? OPEN : '#3a1416');
        setText('prot-text', s.protectionEnabled ? 'HEALTHY' : 'DISABLED');
        const pt = document.getElementById('prot-text');
        if (pt) pt.setAttribute('fill', s.protectionEnabled ? '#39d353' : '#e0483a');

        if (!busLive) setAttr('rtu-state', 'class', 'online'); // keep RTU link up

        // alarm strip
        const list = document.getElementById('alarm-list') as HTMLUListElement;
        list.innerHTML = '';
        if (s.events.length === 0) {
          list.innerHTML = '<li class="quiet">— no active alarms —</li>';
        } else {
          for (const e of s.events) {
            const li = document.createElement('li');
            li.textContent = e;
            if (/BLACKOUT|DEAD|DISABLED|OPEN/.test(e)) li.className = 'crit';
            list.appendChild(li);
          }
        }
      }

      function run(raw: string) {
        print('echo', 'iec> ' + raw);
        const res = sub.execute(raw);
        // clear sentinel
        if (res.lines.length === 1 && res.lines[0].kind === 'info' && res.lines[0].text === 'clear') {
          out.innerHTML = '';
          return;
        }
        res.lines.forEach((l: Line) => print(l.kind, l.text));
        syncDiagram();
        if (res.justWon) {
          const fb = document.getElementById('flagbox');
          if (fb) fb.textContent = sub.FLAG;
          setTimeout(() => {
            win.hidden = false;
            (win.querySelector('.win-card') as HTMLElement | null)?.focus();
          }, 500);
        }
      }

      function closeWin() {
        if (win.hidden) return;
        win.hidden = true;
        cmd.focus();
      }

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const v = cmd.value.trim();
        cmd.value = '';
        if (!v) return;
        history.push(v);
        hIdx = history.length;
        run(v);
      });

      cmd.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowUp') {
          if (hIdx > 0) { hIdx--; cmd.value = history[hIdx]; e.preventDefault(); }
        } else if (e.key === 'ArrowDown') {
          if (hIdx < history.length - 1) { hIdx++; cmd.value = history[hIdx]; }
          else { hIdx = history.length; cmd.value = ''; }
          e.preventDefault();
        }
      });

      document.getElementById('copyflag')?.addEventListener('click', () => {
        navigator.clipboard?.writeText(sub.FLAG).catch(() => {});
      });
      document.getElementById('closewin')?.addEventListener('click', closeWin);
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeWin(); });

      // station clock
      function tick() {
        const d = new Date();
        setText('clock', d.toTimeString().slice(0, 8));
      }
      setInterval(tick, 1000); tick();

      boot();
      syncDiagram();
    </script>

    <style>
      :root {
        --bg: #08111a; --panel: #0b141d; --edge: #1b2a3a;
        --text: #cbd8e6; --dim: #7f93a8; --amber: #e0a63a; --green: #39d353; --red: #e0483a;
        --mono: 'Ubuntu Mono', ui-monospace, monospace;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; height: 100%; }
      body {
        background:
          radial-gradient(1200px 600px at 70% -10%, #0e2030 0%, transparent 60%),
          var(--bg);
        color: var(--text); font-family: var(--mono);
        -webkit-font-smoothing: antialiased;
      }
      .hmi { min-height: 100dvh; display: flex; flex-direction: column; }

      .topbar {
        display: flex; justify-content: space-between; align-items: center; gap: 1rem;
        padding: 0.55rem 1rem; background: linear-gradient(#10202e, #0b1622);
        border-bottom: 1px solid var(--edge); font-size: 0.82rem; letter-spacing: 0.04em;
      }
      .brand { font-weight: 700; color: #e7f0fa; display: flex; align-items: center; gap: 0.5rem; }
      .brand .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--green); box-shadow: 0 0 8px var(--green); }
      .link { color: var(--dim); display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
      .link a { color: var(--dim); text-decoration: none; border: 1px solid var(--edge); border-radius: 4px; padding: 0 0.4rem; }
      .link a:hover { color: var(--green); border-color: var(--green); }
      .clock { color: var(--text); }
      .online { color: var(--green); }
      .sep { opacity: 0.4; }

      .grid {
        flex: 1; display: grid; grid-template-columns: minmax(320px, 460px) 1fr;
        gap: 1rem; padding: 1rem; max-width: 1200px; width: 100%; margin: 0 auto;
      }
      @media (max-width: 820px) { .grid { grid-template-columns: 1fr; } }

      .panel { background: var(--panel); border: 1px solid var(--edge); border-radius: 8px; padding: 0.75rem; }
      .panel-h {
        margin: 0 0 0.6rem; font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase;
        color: var(--dim); font-weight: 700; border-bottom: 1px dashed var(--edge); padding-bottom: 0.4rem;
      }
      .diagram svg { width: 100%; height: auto; display: block; background: #060d14; border-radius: 6px; }
      .lbl { fill: var(--dim); font: 9px var(--mono); }
      .lbl.sm { font-size: 8px; }
      .lbl.mid { text-anchor: middle; }
      .state { fill: var(--red); font: bold 9px var(--mono); }
      .state.sm { font-size: 8px; }
      .state.end { text-anchor: end; }

      .alarms { margin-top: 0.6rem; }
      .alarms-h { font-size: 0.66rem; letter-spacing: 0.16em; color: var(--dim); margin-bottom: 0.3rem; }
      #alarm-list { list-style: none; margin: 0; padding: 0; font-size: 0.78rem; max-height: 120px; overflow: auto; }
      #alarm-list li { padding: 0.12rem 0.3rem; border-left: 2px solid var(--edge); color: var(--text); }
      #alarm-list li.quiet { color: var(--dim); border-color: transparent; }
      #alarm-list li.crit { color: var(--red); border-color: var(--red); animation: blink 1.1s steps(2, start) infinite; }

      .console { display: flex; flex-direction: column; min-height: 380px; }
      .out { flex: 1; overflow: auto; font-size: 0.82rem; line-height: 1.5; padding: 0.2rem 0.1rem; outline: none; }
      .ln { white-space: pre-wrap; word-break: break-word; }
      .ln.echo { color: #6fb3ff; }
      .ln.info { color: var(--text); }
      .ln.ok { color: var(--green); }
      .ln.err { color: var(--red); }
      .ln.alarm { color: #fff; background: rgba(224,72,58,0.18); font-weight: 700; padding: 0.1rem 0.3rem; }
      .ln.lesson { color: var(--amber); font-style: italic; }
      .ln.flag { color: var(--green); font-weight: 700; font-size: 1rem; text-shadow: 0 0 12px rgba(57,211,83,0.6); margin: 0.3rem 0; }

      .prompt { display: flex; align-items: center; gap: 0.5rem; border-top: 1px solid var(--edge); padding-top: 0.6rem; margin-top: 0.4rem; }
      .ps1 { color: var(--green); font-weight: 700; }
      #cmd { flex: 1; background: transparent; border: none; color: var(--text); font-size: 0.9rem; outline: none; caret-color: var(--green); }

      .win { position: fixed; inset: 0; background: rgba(3,7,12,0.82); display: grid; place-items: center; padding: 1rem; z-index: 50; backdrop-filter: blur(3px); }
      .win[hidden] { display: none; }
      .win-card { max-width: 560px; background: #0b141d; border: 1px solid var(--red); border-radius: 10px; padding: 1.5rem; box-shadow: 0 0 40px rgba(224,72,58,0.25); }
      .win-h { color: var(--red); font-weight: 700; letter-spacing: 0.1em; font-size: 1.1rem; }
      .win-sub { color: var(--dim); margin: 0.3rem 0 1rem; }
      .flag { background: #060d14; border: 1px dashed var(--green); color: var(--green); padding: 0.7rem; border-radius: 6px; text-align: center; font-size: 1.05rem; text-shadow: 0 0 10px rgba(57,211,83,0.5); }
      .win-note { color: var(--text); font-size: 0.9rem; line-height: 1.55; margin: 1rem 0; }
      .win-note strong { color: #fff; }
      .win-actions { display: flex; gap: 0.6rem; flex-wrap: wrap; }
      .btn { font-family: var(--mono); font-size: 0.82rem; padding: 0.5rem 0.9rem; border-radius: 6px; border: 1px solid var(--edge); background: transparent; color: var(--text); cursor: pointer; text-decoration: none; }
      .btn.primary { border-color: var(--green); color: var(--green); }
      .btn.primary:hover { background: rgba(57,211,83,0.1); }
      .btn.ghost { color: var(--dim); }

      @keyframes blink { to { opacity: 0.35; } }
      @media (prefers-reduced-motion: reduce) {
        #alarm-list li.crit { animation: none; }
        .win { backdrop-filter: none; }
      }
    </style>
  </body>
</html>
