---
interface Props {
  href: string;
  title: string;
  description: string;
  tags?: string[];
  date?: Date;
}
const { href, title, description, tags = [], date } = Astro.props;
---
<a class="card project" href={href}>
  <h3>{title}</h3>
  <p class="desc">{description}</p>
  <div class="meta">
    {date && <time class="mono" datetime={date.toISOString()}>{date.getFullYear()}</time>}
    <div class="tags">{tags.slice(0, 4).map((t) => <span class="tag">{t}</span>)}</div>
  </div>
</a>

<style>
  .project h3 { color: var(--text); }
  .desc { color: var(--text-dim); margin-top: var(--space-xs); }
  .meta { display: flex; align-items: center; gap: var(--space-s); margin-top: var(--space-s); }
  .meta time { color: var(--cyan-dim); font-size: var(--step--1); }
  .tags { margin-inline-start: auto; text-align: right; }
</style>
