---
import ProjectCard from './ProjectCard.astro';
import { getLangFromUrl, localizedPath } from '../i18n/ui';

interface Item {
  id: string;
  data: { title: string; description: string; tags?: string[]; date: Date };
}
interface Props {
  base: '/projects' | '/blog';
  items: Item[];
  emptyText: string;
}
const { base, items, emptyText } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const sorted = [...items].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
{sorted.length === 0 ? (
  <p class="empty mono">{emptyText}</p>
) : (
  <div class="grid">
    {sorted.map((entry) => (
      <ProjectCard
        href={localizedPath(`${base}/${entry.id}`, lang)}
        title={entry.data.title}
        description={entry.data.description}
        tags={entry.data.tags}
        date={entry.data.date}
      />
    ))}
  </div>
)}

<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); gap: var(--space-m); }
  .empty { color: var(--text-faint); padding-block: var(--space-l); }
</style>
