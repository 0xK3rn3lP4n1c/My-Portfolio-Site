---
interface Item { src: string; title?: string }
interface Props { items: Item[] }
const { items } = Astro.props;
---
<div class="gallery" id="gallery">
  {items.map((it) => (
    <button class="cell" type="button" data-src={it.src} data-title={it.title ?? ''} aria-label={it.title ?? 'Tasarım'}>
      <img src={it.src} alt={it.title ?? ''} loading="lazy" decoding="async" width="1000" height="1000" />
      {it.title && <span class="cap mono">{it.title}</span>}
    </button>
  ))}
</div>

<!-- Lightbox -->
<div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="Görsel önizleme" hidden>
  <button class="close" type="button" aria-label="Kapat">✕</button>
  <figure>
    <img id="lightbox-img" src="" alt="" />
    <figcaption id="lightbox-cap" class="mono"></figcaption>
  </figure>
</div>

<script>
  import { initGallery } from '../scripts/gallery';
  initGallery();
</script>

<style>
  .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: var(--space-s); }
  .cell {
    position: relative; padding: 0; border: 1px solid var(--border); border-radius: var(--radius-s);
    overflow: hidden; cursor: zoom-in; background: var(--bg-elev); aspect-ratio: 1; display: block;
  }
  .cell img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease, opacity 0.3s ease; }
  .cell:hover img { transform: scale(1.05); }
  .cap {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 6px 8px; font-size: var(--step--1);
    color: var(--text); background: linear-gradient(transparent, rgba(7, 11, 18, 0.85)); text-align: left;
    opacity: 0; transition: opacity 0.2s ease;
  }
  .cell:hover .cap, .cell:focus-visible .cap { opacity: 1; }

  .lightbox {
    position: fixed; inset: 0; z-index: 100; display: flex; align-items: center; justify-content: center;
    background: rgba(3, 6, 12, 0.92); padding: var(--space-m); backdrop-filter: blur(4px);
  }
  .lightbox[hidden] { display: none; }
  .lightbox figure { margin: 0; max-width: min(92vw, 900px); text-align: center; }
  .lightbox img { max-width: 100%; max-height: 82vh; border-radius: var(--radius-s); }
  .lightbox figcaption { color: var(--text-dim); margin-top: var(--space-s); font-size: var(--step--1); }
  .lightbox .close {
    position: absolute; top: 1rem; right: 1rem; width: 2.4rem; height: 2.4rem; border-radius: 50%;
    background: var(--bg-elev); color: var(--text); border: 1px solid var(--border); cursor: pointer; font-size: 1rem;
  }
  .lightbox .close:hover { border-color: var(--cyan-dim); color: var(--cyan); }
</style>
